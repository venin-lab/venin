{
  "name": "venin",
  "version": "0.1.0",
  "description": "The Venin check-up as WebAssembly: finds orders planted in an AI agent's skills, memory notes and settings.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "venin_core.js", "venin_core_bg.wasm"],
  "scripts": {
    "build": "node ../web/scripts/wasm.mjs && cp ../web/src/wasm/venin_core.js ../web/src/wasm/venin_core_bg.wasm ../LICENSE .",
    "test": "node --test"
  },
  "homepage": "https://venin.io/checkup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venin-lab/venin.git",
    "directory": "npm"
  },
  "keywords": ["ai-agent", "agent-security", "prompt-injection", "mcp", "scanner", "wasm"]
}
